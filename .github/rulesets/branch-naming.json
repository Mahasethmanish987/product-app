{
  "name": "branch naming",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "disabled",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/uat",
        "refs/heads/dev",
        "refs/heads/feat/**/*",
        "refs/heads/fix/**/*",
        "refs/heads/bug/**/*",
        "refs/heads/hotfix/**/*",
        "refs/heads/refactor/**/*",
        "refs/heads/chore/**/*"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ],
  "bypass_actors": []
}
